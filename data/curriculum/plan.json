  "acceptance": [
    "96 distinct lesson objectives, 8 categories and at least 12 lessons each",
    "Every lesson includes contextual meaning, whole-word model, phrase/sentence practice, retrieval, communicative transfer and summary",
    "New material has explicit prerequisites and constrained load; review lessons integrate rather than add arbitrary vocabulary",
    "All referenced assets exist and lesson navigation/summary/checkpoint contracts pass",
    "Every English clip is independently transcribed after final export; word alignment and phoneme quality are checked; extra tails are rejected",
    "Second pass reviews curriculum progression, grammar, translations, prompts, answer paths and playback behavior",
    "Publish one immutable private COS release only after both App and admin validation; retain rollback version"
  ],
  "legacyPolicy": "Original eight experimental courses are replaced; no legacy IDs or sequencing constraints."
}
